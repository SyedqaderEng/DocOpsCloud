# Database
DATABASE_URL="postgresql://user:password@localhost:5432/docopscloud"

# NextAuth.js
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Redis (Upstash)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# File Storage
# Set to 'true' for local development, 'false' for S3/MinIO
USE_LOCAL_STORAGE="true"
LOCAL_STORAGE_PATH="./storage"

# AWS S3 / Cloudflare R2 / MinIO
S3_BUCKET_NAME="docopscloud-files"
S3_REGION="us-east-1"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_ENDPOINT=""  # Leave empty for AWS S3, set for MinIO (e.g., "http://localhost:9000")

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Email (Resend or SendGrid)
EMAIL_FROM="noreply@docopscloud.com"
RESEND_API_KEY="re_your_resend_api_key"

# OCR API (optional)
OCR_SPACE_API_KEY="your-ocr-space-api-key"

# Worker Configuration
WORKER_CONCURRENCY="5"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
