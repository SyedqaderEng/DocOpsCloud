# Copy this file to .env.local and fill in your actual values

# ============================================
# DATABASE (REQUIRED)
# ============================================
DATABASE_URL="postgresql://docops:yourpassword@localhost:5432/docopscloud"

# ============================================
# NEXTAUTH (REQUIRED)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# REDIS (REQUIRED)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# STORAGE - AWS S3 or Cloudflare R2 (REQUIRED)
# ============================================
S3_BUCKET_NAME="docopscloud-dev"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_ENDPOINT="https://your-bucket.s3.amazonaws.com"

# For Cloudflare R2, use:
# S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ============================================
# STRIPE PAYMENTS (Optional - for subscriptions)
# ============================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Price IDs from Stripe Dashboard
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_1234567890"
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID="price_0987654321"

# ============================================
# EMAIL (Optional - for notifications)
# ============================================
EMAIL_FROM="noreply@docopscloud.com"

# Using Resend (recommended)
RESEND_API_KEY="re_your_resend_api_key"

# Or using SendGrid
# SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# ============================================
# APPLICATION
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# OPTIONAL SERVICES
# ============================================
# OCR API (optional - for PDF OCR)
OCR_SPACE_API_KEY="your-ocr-space-api-key"
