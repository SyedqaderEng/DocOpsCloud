# Production Environment Variables Template
# Copy this file to .env.production and fill in the values

# Application
NODE_ENV=production
APP_VERSION=2.0.0
PORT=3000
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=generate-a-secure-random-string-here

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/docops?schema=public
POSTGRES_DB=docops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-secure-password
DATABASE_MAX_CONNECTIONS=20

# Redis Cache
REDIS_URL=redis://:password@redis:6379
REDIS_PASSWORD=change-this-redis-password

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key

# Encryption
ENCRYPTION_KEY=generate-64-char-hex-string-here
ENCRYPTION_KEY_VERSION=1
HMAC_SECRET=generate-another-secure-random-string

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Integrations - Google Drive
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret

# Integrations - Dropbox
DROPBOX_CLIENT_ID=your-dropbox-client-id
DROPBOX_CLIENT_SECRET=your-dropbox-client-secret

# Integrations - Microsoft
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Integrations - Slack
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# Integrations - Salesforce
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret

# Integrations - HubSpot
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret

# Integrations - Notion
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret

# SSO - Okta
OKTA_DOMAIN=your-domain.okta.com
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret

# SSO - Azure AD
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email (SendGrid or similar)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# Monitoring
DATADOG_API_KEY=your-datadog-api-key (optional)
SENTRY_DSN=your-sentry-dsn (optional)
NEW_RELIC_LICENSE_KEY=your-newrelic-key (optional)

# CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_WORKFLOWS=true
ENABLE_INTEGRATIONS=true
ENABLE_SSO=true
ENABLE_GDPR_TOOLS=true
ENABLE_HIPAA_TOOLS=true

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Security
BREACH_NOTIFICATION_EMAIL=security@yourdomain.com

# Monitoring - Grafana
GRAFANA_PASSWORD=change-this-grafana-password

# CDN
CDN_URL=https://cdn.yourdomain.com (optional)

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
