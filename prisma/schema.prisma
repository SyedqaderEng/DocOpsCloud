// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password_hash String?
  email_verified DateTime?
  avatar_url    String?

  // Subscription details
  subscription_tier    SubscriptionTier   @default(FREE)
  subscription_status  SubscriptionStatus @default(INACTIVE)
  subscription_expires_at DateTime?

  // Stripe integration
  stripe_customer_id String? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  files                 File[]
  processing_jobs       ProcessingJob[]
  subscription          Subscription?
  usage_logs            UsageLog[]
  api_keys              ApiKey[]
  email_verification_tokens EmailVerificationToken[]
  password_reset_tokens     PasswordResetToken[]

  @@index([email])
  @@index([stripe_customer_id])
  @@index([subscription_status])
  @@map("users")
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  EXPIRED
}

// ==================== AUTHENTICATION ====================

model Account {
  id                String  @id @default(cuid())
  user_id           String
  type              String
  provider          String
  provider_account_id String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  session_token String   @unique
  user_id      String
  expires      DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id      String   @id @default(cuid())
  user_id String
  token   String   @unique
  expires DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  user_id String
  token   String   @unique
  expires DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ==================== FILE MANAGEMENT ====================

model File {
  id                String           @id @default(cuid())
  user_id           String

  // File metadata
  original_name     String
  stored_name       String
  file_type         FileType
  file_size         BigInt
  mime_type         String

  // Storage details
  s3_url            String
  thumbnail_url     String?

  // Status tracking
  upload_status     UploadStatus     @default(UPLOADING)
  processing_status ProcessingStatus @default(PENDING)

  // Timestamps
  created_at DateTime @default(now())
  expires_at DateTime

  // Relations
  user                 User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  input_jobs           ProcessingJob[] @relation("InputFile")
  output_jobs          ProcessingJob[] @relation("OutputFile")

  @@index([user_id])
  @@index([created_at])
  @@index([processing_status])
  @@index([expires_at])
  @@map("files")
}

enum FileType {
  PDF
  DOCX
  XLSX
  CSV
  IMAGE
  OTHER
}

enum UploadStatus {
  UPLOADING
  COMPLETE
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

// ==================== JOB PROCESSING ====================

model ProcessingJob {
  id               String           @id @default(cuid())
  user_id          String
  input_file_id    String
  output_file_id   String?

  // Job details
  operation_type   String
  operation_params Json?

  // Status tracking
  status           JobStatus        @default(QUEUED)
  progress_percentage Int           @default(0)
  error_message    String?

  // Timestamps
  started_at    DateTime?
  completed_at  DateTime?
  created_at    DateTime  @default(now())

  // Relations
  user        User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  input_file  File  @relation("InputFile", fields: [input_file_id], references: [id])
  output_file File? @relation("OutputFile", fields: [output_file_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("processing_jobs")
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
  CANCELED
}

// ==================== SUBSCRIPTIONS & BILLING ====================

model Subscription {
  id                      String             @id @default(cuid())
  user_id                 String             @unique

  // Stripe details
  stripe_subscription_id  String             @unique
  stripe_price_id         String

  // Plan details
  plan_type               SubscriptionTier
  status                  SubscriptionStatus

  // Billing cycle
  current_period_start    DateTime
  current_period_end      DateTime
  cancel_at_period_end    Boolean            @default(false)
  canceled_at             DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([stripe_subscription_id])
  @@map("subscriptions")
}

// ==================== USAGE TRACKING ====================

model UsageLog {
  id                   String   @id @default(cuid())
  user_id              String

  // Operation details
  operation_type       String
  file_size_processed  BigInt
  processing_time_ms   Int
  credits_used         Int      @default(1)

  created_at DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
  @@map("usage_logs")
}

// ==================== API ACCESS ====================

model ApiKey {
  id         String    @id @default(cuid())
  user_id    String

  // Key details
  key_hash   String    @unique
  name       String

  // Usage tracking
  last_used_at DateTime?

  // Lifecycle
  expires_at DateTime?
  revoked_at DateTime?
  created_at DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([key_hash])
  @@map("api_keys")
}

// ==================== GAMIFICATION ====================

model UserStats {
  id              String   @id @default(cuid())
  user_id         String   @unique

  // XP & Level
  total_xp        Int      @default(0)
  level           Int      @default(1)

  // Streak tracking
  current_streak  Int      @default(0)
  longest_streak  Int      @default(0)
  last_active_date DateTime?

  // Usage stats
  total_operations     Int @default(0)
  total_files_processed Int @default(0)
  total_storage_used   BigInt @default(0)

  // Tool usage
  unique_tools_used    String[] @default([])
  favorite_tool        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("user_stats")
}

model UserAchievement {
  id              String   @id @default(cuid())
  user_id         String
  achievement_id  String

  // Achievement details
  unlocked_at     DateTime @default(now())
  xp_awarded      Int      @default(0)

  @@unique([user_id, achievement_id])
  @@index([user_id])
  @@map("user_achievements")
}

model DailyActivity {
  id          String   @id @default(cuid())
  user_id     String
  date        DateTime @db.Date

  // Daily metrics
  operations_count  Int @default(0)
  files_processed   Int @default(0)
  xp_earned         Int @default(0)

  @@unique([user_id, date])
  @@index([user_id])
  @@index([date])
  @@map("daily_activity")
}

model Leaderboard {
  id          String   @id @default(cuid())
  user_id     String
  period      LeaderboardPeriod
  period_start DateTime

  // Scores
  total_xp    Int @default(0)
  operations  Int @default(0)
  streak      Int @default(0)
  rank        Int?

  updated_at  DateTime @updatedAt

  @@unique([user_id, period, period_start])
  @@index([period, period_start, total_xp])
  @@map("leaderboard")
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

// ==================== WORKFLOWS ====================

model Workflow {
  id          String   @id @default(cuid())
  user_id     String
  team_id     String?

  // Workflow details
  name        String
  description String?
  trigger     Json
  steps       Json
  variables   Json?

  // Status
  status      WorkflowStatus @default(DRAFT)
  is_template Boolean        @default(false)
  version     Int            @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  runs WorkflowRun[]

  @@index([user_id])
  @@index([team_id])
  @@index([status])
  @@map("workflows")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflow_id  String
  triggered_by String

  // Run details
  trigger_type String
  trigger_data Json?
  status       WorkflowRunStatus
  current_step Int       @default(0)
  step_results Json?
  error        String?

  started_at   DateTime  @default(now())
  completed_at DateTime?

  // Relations
  workflow Workflow @relation(fields: [workflow_id], references: [id])

  @@index([workflow_id])
  @@index([status])
  @@index([started_at])
  @@map("workflow_runs")
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ScheduledTrigger {
  id          String   @id @default(cuid())
  workflow_id String   @unique

  // Schedule details
  cron_expr   String
  timezone    String   @default("UTC")
  next_run    DateTime
  last_run    DateTime?
  enabled     Boolean  @default(true)

  @@map("scheduled_triggers")
}

// ==================== TEAMS ====================

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  owner_id    String

  // Team settings
  logo_url    String?
  settings    Json     @default("{}")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  members TeamMember[]

  @@index([owner_id])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  team_id  String
  user_id  String
  role     TeamRole

  // Custom permissions
  permissions Json?

  joined_at DateTime @default(now())

  // Relations
  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([user_id])
  @@map("team_members")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model TeamInvite {
  id       String   @id @default(cuid())
  team_id  String
  email    String
  role     TeamRole
  token    String   @unique

  expires_at DateTime
  created_at DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("team_invites")
}

// ==================== AI USAGE ====================

model AIUsage {
  id           String   @id @default(cuid())
  user_id      String

  // Operation details
  operation    String
  model        String
  tokens_input Int
  tokens_output Int
  cost         Decimal  @db.Decimal(10, 6)
  cached       Boolean  @default(false)
  latency_ms   Int

  created_at DateTime @default(now())

  @@index([user_id, created_at])
  @@index([operation])
  @@map("ai_usage")
}

// ==================== INTEGRATIONS ====================

model IntegrationConnection {
  id             String   @id @default(cuid())
  user_id        String
  team_id        String?

  // Integration details
  provider       String
  credentials    String   // Encrypted JSON
  status         IntegrationStatus
  metadata       Json?

  last_used      DateTime?
  expires_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, provider])
  @@index([team_id])
  @@map("integration_connections")
}

enum IntegrationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id              String   @id @default(cuid())
  user_id         String?
  organization_id String?

  // Action details
  action          String
  resource_type   String
  resource_id     String?
  metadata        Json?

  // Request info
  ip_address      String?
  user_agent      String?

  created_at DateTime @default(now())

  @@index([user_id, created_at])
  @@index([action])
  @@index([resource_type, resource_id])
  @@map("audit_logs")
}

// ==================== SSO CONFIGURATION ====================

model SSOConfiguration {
  id              String   @id @default(cuid())
  organization_id String?  // For enterprise multi-tenancy

  // Provider details
  provider_type   String   // 'saml', 'oidc', 'okta', 'azure-ad'
  provider_name   String   // Display name

  // SAML specific
  entity_id       String?
  sso_url         String?
  certificate     String?  @db.Text

  // OIDC specific
  client_id       String?
  client_secret   String?  @db.Text
  discovery_url   String?

  // Common settings
  enabled         Boolean  @default(false)
  auto_provision  Boolean  @default(false) // Auto-create users on first login
  default_role    String?  // Default role for auto-provisioned users

  // Attribute mappings (JSON)
  attribute_mappings Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([organization_id, provider_type])
  @@index([provider_type])
  @@index([enabled])
  @@map("sso_configurations")
}

model SSOSession {
  id          String   @id @default(cuid())
  user_id     String
  provider_id String

  // Session details
  sso_user_id String   // User ID from SSO provider
  attributes  Json?    // All attributes from SSO response
  groups      String[] // User groups from SSO

  // Session management
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([provider_id])
  @@index([expires_at])
  @@map("sso_sessions")
}
